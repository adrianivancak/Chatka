# Copy this file to ".env" (same folder) and fill in real values.
# .env is where all secrets live — never commit it or share it publicly.

# --- Admin login ---
# Generate this with: node hash-password.js "yourNewPassword"
# Never put a plain-text password here — only the hash it prints.
ADMIN_PASSWORD_HASH=

# Random long string used to sign session cookies. Any long random text works.
SESSION_SECRET=change-this-to-a-long-random-string

# --- Email delivery (reservation requests + contact form) ---
# Prefilled for Gmail. You need a Gmail "app password", not your normal
# password — see README.md, "Setting up real email delivery".
# Using a different provider (Resend, Brevo, etc.)? Just change SMTP_HOST
# and SMTP_PORT to match theirs.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=youraddress@gmail.com
SMTP_PASS=your16digitapppassword
MAIL_FROM=Chata pod Belianskymi Tatrami <youraddress@gmail.com>
MAIL_TO=youraddress@gmail.com

# --- Server ---
PORT=3000
# Your real public domain once live, e.g. https://chatapodbelianskymitatrami.sk
# Used to build the review-page link mentioned in reservation emails.
SITE_URL=http://localhost:3000
